<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Production caches config/routes; tests must ignore those caches. -->
        <env name="APP_CONFIG_CACHE" value="/tmp/thrive-test-config.php"/>
        <env name="APP_ROUTES_CACHE" value="/tmp/thrive-test-routes.php"/>
        <env name="APP_EVENTS_CACHE" value="/tmp/thrive-test-events.php"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BUNNY_API_KEY" value=""/>
        <env name="BUNNY_WEBHOOK_SECRET" value="test-webhook-secret"/>
        <env name="PAYCHANGU_SECRET_KEY" value="sec-test-key"/>
        <env name="PAYCHANGU_WEBHOOK_SECRET" value="paychangu-test-secret"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="thrive_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Keep tests off the dev app's Redis DB (heartbeat tests drain heartbeats:queue). -->
        <env name="REDIS_DB" value="15"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Compiled views in storage/ are owned by www-data; keep test compiles separate. -->
        <env name="VIEW_COMPILED_PATH" value="/tmp/thrive-test-views"/>
    </php>
</phpunit>
